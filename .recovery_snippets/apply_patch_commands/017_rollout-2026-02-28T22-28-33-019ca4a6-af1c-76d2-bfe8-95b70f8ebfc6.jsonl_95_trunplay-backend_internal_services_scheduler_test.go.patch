+func openSchedulerTestDB(t *testing.T) *dbstore.DB {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "scheduler-test.db")
+	database, err := dbstore.OpenAt(path)
+	if err != nil {
+		t.Fatalf("open db: %v", err)
+	}
+	if err := dbstore.Init(database); err != nil {
+		_ = database.Close()
+		t.Fatalf("init db: %v", err)
+	}
+	t.Cleanup(func() {
+		_ = database.Close()
+	})
+	return database
+}
