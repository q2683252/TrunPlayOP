+func TestTriggerPlan_DoesNotMarkDateOnTransientStartFailure(t *testing.T) {
+	database := openSchedulerTestDB(t)
+	playback := NewPlaybackService(nil, nil, nil, database, 8088)
+	s := NewScheduler(database, playback)
+	today := "2026-02-28"
+
+	tx, err := database.Begin()
+	if err != nil {
+		t.Fatalf("begin tx: %v", err)
+	}
+	created, err := dbstore.CreatePlan(tx, "Transient", "09:00", "", "1,2,3,4,5", "dev-1", "noop://media", "SEQUENTIAL", false, true)
+	if err != nil {
+		t.Fatalf("create plan: %v", err)
+	}
+	if err := tx.Commit(); err != nil {
+		t.Fatalf("commit create: %v", err)
+	}
+
+	s.triggerPlan(created, today)
+
+	tx2, err := database.Begin()
+	if err != nil {
+		t.Fatalf("begin tx2: %v", err)
+	}
+	updated, err := dbstore.GetPlan(tx2, created["id"].(string))
+	if err != nil {
+		t.Fatalf("get plan: %v", err)
+	}
+	_ = tx2.Rollback()
+	if got, _ := updated["last_triggered_date"].(string); got != "" {
+		t.Fatalf("expected empty last_triggered_date, got %q", got)
+	}
+}
